DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173
MAX_UPLOAD_SIZE=52428800
ALLOWED_UPLOAD_EXTENSIONS=pdf,png,jpg,jpeg,gif,webp,doc,docx,odt,rtf,xls,xlsx,ods,csv,mp4,mov,webm,txt,md

# Optional production object storage (Supabase Storage S3-compatible endpoint)
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_SIGNED_URL_TTL=300

# Google Drive API key (enable Google Drive API; shared folders must be accessible to anyone with the link)
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_IMPORT_MAX_FILE_SIZE=52428800
GOOGLE_DRIVE_IMPORT_MAX_TOTAL_SIZE=524288000
